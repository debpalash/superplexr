<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.superplexr.desktop</id>
  <name>SuperPlexr</name>
  <summary>Native mission control for coding agents</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      SuperPlexr is a native desktop application for running and supervising
      parallel coding agents. It combines durable terminal sessions,
      browser-like Mission workspaces, structured agent attention, and
      auditable human control.
    </p>
  </description>
  <launchable type="desktop-id">com.superplexr.desktop.desktop</launchable>
  <provides>
    <binary>superplexr-desktop</binary>
  </provides>
  <url type="homepage">https://github.com/debpalash/superplexr</url>
  <url type="bugtracker">https://github.com/debpalash/superplexr/issues</url>
  <url type="vcs-browser">https://github.com/debpalash/superplexr</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/debpalash/superplexr/main/docs/assets/launch/desktop-waterfall-framed.png</image>
      <caption>Mission tabs, Session status, and a two-terminal waterfall in the native desktop</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/debpalash/superplexr/main/docs/assets/launch/desktop-command-deck-framed.png</image>
      <caption>Keyboard-first command deck for navigating and supervising agent work</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/debpalash/superplexr/main/docs/assets/launch/desktop-focus-framed.png</image>
      <caption>Focus mode for reviewing one agent Session in context</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.0" date="2026-09-01"/>
  </releases>
</component>
